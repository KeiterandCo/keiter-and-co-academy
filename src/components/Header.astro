---
const navItems = [
  { label: 'Curriculum', href: '/curriculum' },
  { label: 'Resources', href: '/resources' },
  { label: 'Glossary', href: '/glossary' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-cream border-b border-stone/30 sticky top-0 z-40">
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div class="container flex items-center justify-between py-4">
    <!-- Logo / wordmark -->
    <a
      href="/"
      class="font-serif text-xl font-bold text-off-black no-underline hover:text-rust transition-colors"
      aria-label="Keiter & Co. Academy home"
    >
      Keiter &amp; Co. Academy
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Main navigation" class="hidden md:flex items-center gap-6">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm font-medium no-underline transition-colors',
            currentPath.startsWith(item.href)
              ? 'text-rust font-semibold'
              : 'text-bark hover:text-rust',
          ]}
          aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <!-- Search trigger -->
      <a
        href="/search"
        aria-label="Open search"
        class="ml-2 p-2 rounded text-bark hover:text-rust hover:bg-mauve-faint transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>
    </nav>

    <!-- Mobile: search + hamburger -->
    <div class="flex items-center gap-2 md:hidden">
      <a
        href="/search"
        aria-label="Open search"
        class="p-2 rounded text-bark hover:text-rust min-w-[44px] min-h-[44px] flex items-center justify-center"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>
      <button
        id="mobile-nav-trigger"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="p-2 rounded text-bark hover:text-rust min-w-[44px] min-h-[44px] flex items-center justify-center"
      >
        <svg id="hamburger-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="close-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const trigger = document.getElementById('mobile-nav-trigger');
  const mobileNav = document.getElementById('mobile-nav');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  trigger?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('hidden');
    trigger.setAttribute('aria-expanded', isOpen === false ? 'true' : 'false');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileNav && !mobileNav.classList.contains('hidden')) {
      mobileNav.classList.add('hidden');
      trigger?.setAttribute('aria-expanded', 'false');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      trigger?.focus();
    }
  });
</script>
