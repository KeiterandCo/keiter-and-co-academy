---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Pull from content collection. Additional resources are listed statically below
// until all resource files are written in Phase 7.
const collectionResources = await getCollection('resources');

// Group collection resources by type for merging with static sections
const collectionByType: Record<string, typeof collectionResources> = {};
for (const entry of collectionResources) {
  const type = entry.data.fileType;
  if (!collectionByType[type]) collectionByType[type] = [];
  collectionByType[type].push(entry);
}

function getDownloads(entry: (typeof collectionResources)[number]) {
  const explicitDownloads = entry.data.downloads ?? [];
  if (explicitDownloads.length > 0) {
    return explicitDownloads;
  }

  if (entry.data.downloadPath) {
    return [{ label: 'Markdown', path: entry.data.downloadPath }];
  }

  return [];
}
---

<Layout
  title="Resources"
  metaTitle="Resources | Keiter & Co. Academy"
  description="Download Keiter templates, checklists, cheat sheets, and worked examples you can use during real builds."
>
  <section class="section bg-warm-white border-b border-stone/20">
    <div class="container">
      <p class="text-sm font-medium text-moss uppercase tracking-wide mb-3">Resources</p>
      <h1 class="mb-4">Templates, checklists, and cheat sheets.</h1>
      <p class="text-bark/80 max-w-xl">
        Everything you need to run a Keiter &amp; Co. build without re-reading the curriculum every time. Templates download as Markdown. Cheat sheets download as Markdown and PDF where available.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid gap-10 max-w-4xl">

        <div>
          <h2 class="text-xl mb-6">Templates</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {collectionByType['template']?.map((entry) => (
              <div class="bg-warm-white border border-moss/30 rounded-lg p-5 flex flex-col gap-2">
                <h3 class="text-base">{entry.data.title}</h3>
                <p class="text-sm text-bark/70 flex-1 max-w-none">{entry.data.description}</p>
                <div class="flex flex-wrap gap-2 pt-2">
                  {getDownloads(entry).map((download) => (
                    <a href={download.path} class="inline-flex min-h-[32px] items-center rounded-full border border-moss/30 px-3 py-1 text-xs font-medium text-moss no-underline transition-colors hover:border-rust hover:text-rust focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-moss" download>
                      {download.label}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2 class="text-xl mb-6">Cheat sheets</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {collectionByType['cheat-sheet']?.map((entry) => (
              <div class="bg-warm-white border border-moss/30 rounded-lg p-5 flex flex-col gap-2">
                <h3 class="text-base">{entry.data.title}</h3>
                <p class="text-sm text-bark/70 flex-1 max-w-none">{entry.data.description}</p>
                <div class="flex flex-wrap gap-2 pt-2">
                  {getDownloads(entry).map((download) => (
                    <a href={download.path} class="inline-flex min-h-[32px] items-center rounded-full border border-moss/30 px-3 py-1 text-xs font-medium text-moss no-underline transition-colors hover:border-rust hover:text-rust focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-moss" download>
                      {download.label}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2 class="text-xl mb-6">Worked examples</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {collectionByType['worked-example']?.map((entry) => (
              <div class="bg-warm-white border border-moss/30 rounded-lg p-5 flex flex-col gap-2">
                <h3 class="text-base">{entry.data.title}</h3>
                <p class="text-sm text-bark/70 flex-1 max-w-none">{entry.data.description}</p>
                <div class="flex flex-wrap gap-2 pt-2">
                  {getDownloads(entry).map((download) => (
                    <a href={download.path} class="inline-flex min-h-[32px] items-center rounded-full border border-moss/30 px-3 py-1 text-xs font-medium text-moss no-underline transition-colors hover:border-rust hover:text-rust focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-moss" download>
                      {download.label}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
